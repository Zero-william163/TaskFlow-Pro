<?xml version="1.0" encoding="utf-8"?>
<!-- 右上角胶囊 Badge 背景：微渐变 + 圆角 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="@color/widget_badge_bg_start"
        android:endColor="@color/widget_badge_bg_end"
        android:angle="135" />
    <corners android:radius="16dp" />
    <padding
        android:left="10dp"
        android:top="4dp"
        android:right="10dp"
        android:bottom="4dp" />
</shape>
