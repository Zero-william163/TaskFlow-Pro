<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive Icon Background：紫蓝渐变 (#4A00E0 → #8E2DE2)
    - 使用 vector inset + gradient layer-list 实现渐变底
    - 适配 mipmap-anydpi-v26
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 渐变背景：通过 path 填充整个 108x108 区域，配合 gradientColor 近似渐变 -->
    <path
        android:fillColor="#6D1AE1"
        android:pathData="M0,0h108v108h-108z" />
    <!-- 渐变装饰：中心光晕 (从 #4A00E0 到 #8E2DE2 的径向视觉近似) -->
    <path
        android:fillColor="#4A00E0"
        android:fillAlpha="0.65"
        android:pathData="M0,0h54v54h-54z" />
    <path
        android:fillColor="#8E2DE2"
        android:fillAlpha="0.65"
        android:pathData="M54,54h54v54h-54z" />
    <!-- 中心柔和高光点 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.06"
        android:pathData="M34,22m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0" />
</vector>
