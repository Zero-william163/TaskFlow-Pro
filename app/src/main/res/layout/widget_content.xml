<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget 主布局（清爽版 v2）
    - 容器：24dp 软圆角 + 1dp 极细边框 + Surface 半透明背景
    - Header 精简：左 TaskFlow 品牌（Logo+文字，单行，不会换行）
                  右 Pill 胶囊 Badge (还有 X 个任务)
    - 移除：刷新按钮、+ 新建按钮（这些按钮用户反馈"不知道是干嘛的"+"加号可以删掉"）
    - 列表：ListView（空态由 Factory 返回内联空项）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp"
    android:clipToPadding="false">

    <!-- ===== Header（Logo + Brand | Pill Badge） ===== -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Logo + Brand（单行，绝不换行） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_icon_logo"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/app_name"
                android:textColor="@color/widget_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Pill Capsule Badge（右对齐） -->
        <TextView
            android:id="@+id/count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minHeight="26dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:gravity="center"
            android:background="@drawable/widget_badge_pill"
            android:text="@string/widget_all_done"
            android:textColor="@color/widget_badge_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Divider（柔和分割线） -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null" />

    <!-- ===== Scrollable Task List ===== -->
    <ListView
        android:id="@+id/task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false" />

    <!-- Legacy empty placeholder（GONE always，仅保留给 RemoteViews 稳定性） -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:includeFontPadding="false" />
</LinearLayout>
