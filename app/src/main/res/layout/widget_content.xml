<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget 主布局：高颜值重构版
    - 容器：24dp 软圆角 + 1dp 边框 + Surface 背景
    - Header 左：TaskFlow 矢量 Logo + 品牌名
    - Header 右：微渐变 Pill 胶囊 Badge (还有X个任务) + 刷新/+ 图标
    - 列表：ListView (永远保持 VISIBLE，空态由 Factory 返回内联空项)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp"
    android:clipToPadding="false">

    <!-- ===== Header ===== -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Logo + Brand -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_icon_logo"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/app_name"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Right: Quick Actions (Refresh + New) -->
        <LinearLayout
            android:id="@+id/widget_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginEnd="6dp">

            <!-- Refresh Icon Button -->
            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="5dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_icon_refresh"
                android:scaleType="fitCenter" />

            <!-- New (+) Icon Button -->
            <ImageView
                android:id="@+id/widget_btn_new"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="5dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_icon_plus"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- Pill Capsule Badge -->
        <TextView
            android:id="@+id/count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_badge_pill"
            android:text="@string/widget_all_done"
            android:textColor="@color/widget_badge_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center" />
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null" />

    <!-- ===== Scrollable Task List ===== -->
    <!-- Always VISIBLE — Factory returns count>=1 with inline empty item when no tasks -->
    <ListView
        android:id="@+id/task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false" />

    <!-- Legacy empty placeholder (GONE always, kept for RemoteViews stability) -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:includeFontPadding="false" />
</LinearLayout>
