<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget 主布局（v4）
    - Header：左 Brand 标题 / 右 Pill Badge + 刷新按钮（去掉左上角小方框 Logo）
    - 列表：ListView
    - Footer：右下角小圆形加号（点击直接弹出创建任务对话框）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp"
    android:clipToPadding="false">

    <!-- ===== Header（Brand | Pill Badge + 刷新按钮） ===== -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Brand（单行，去掉了左侧正方形小图标） + 模式切换 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/widget_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <!-- 模式切换按钮：今日 / 全部 -->
            <TextView
                android:id="@+id/widget_btn_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="24dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:gravity="center"
                android:background="@drawable/widget_badge_pill"
                android:text="今日"
                android:textColor="@color/widget_badge_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Right: Pill Capsule Badge + 刷新小图标 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="26dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:gravity="center"
                android:background="@drawable/widget_badge_pill"
                android:text="@string/widget_all_done"
                android:textColor="@color/widget_badge_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:padding="4dp"
                android:src="@drawable/widget_icon_refresh"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider（柔和分割线） -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null" />

    <!-- ===== Scrollable Task List ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/task_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:clipToPadding="false" />

        <!-- 右下角小圆形加号（新建任务） -->
        <ImageView
            android:id="@+id/widget_btn_new"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="@drawable/widget_plus_fab_bg"
            android:padding="6dp"
            android:src="@drawable/widget_icon_plus"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Legacy empty placeholder（GONE always，仅保留给 RemoteViews 稳定性） -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:includeFontPadding="false" />
</LinearLayout>
