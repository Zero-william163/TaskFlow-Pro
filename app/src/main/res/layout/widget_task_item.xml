<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget 任务卡片 v3 — 点击彻底隔离版
    关键规则：
      - 根布局 widget_item_root 绝不绑定任何 PendingIntent (避免吞掉子区域点击)
      - widget_checkbox (48dp 触摸区) 仅绑定 ACTION_TOGGLE_COMPLETE 广播
      - widget_card_body (标题/分类/时间) 仅绑定跳转 PomodoroActivity 的 FillInIntent
    视觉：16dp 大圆角渐变背景 (与主 App TaskCard 风景渐变统一)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/widget_item_card_bg"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <!-- Checkbox Circle — 48dp x 48dp 触摸区，独立 id=widget_checkbox，
         仅绑定 ACTION_TOGGLE_COMPLETE 广播，绝不跳转应用。 -->
    <FrameLayout
        android:id="@+id/widget_checkbox"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"
        android:clipToPadding="false">
        <ImageView
            android:id="@+id/item_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/widget_checkbox_circle"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Title + Meta Column — id=widget_card_body，
         仅此区域绑定跳转 PomodoroActivity 的 FillInIntent。 -->
    <LinearLayout
        android:id="@+id/widget_card_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title: Bold 粗体 + item card 专用浅色 (深色风景渐变背景上保证可读) -->
        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_item_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <!-- Meta Row: Category Tag Pill + Due Time -->
        <LinearLayout
            android:id="@+id/item_meta_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Category Capsule Tag (默认 gone, RemoteViews 有值时 VISIBLE) -->
            <TextView
                android:id="@+id/item_category_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_category_tag_bg"
                android:textColor="@color/widget_tag_default_text"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <!-- Due Time: Secondary Muted 弱化字色 (item card 专用浅色) -->
            <TextView
                android:id="@+id/item_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/widget_item_text_secondary"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
